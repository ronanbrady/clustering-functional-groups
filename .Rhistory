library(ISLR)
library(caret)
dat = eudirectlapse
dat = na.omit(dat)
dat$polholder_BMCevol = as.factor(dat$polholder_BMCevol)
dat$polholder_gender = as.factor(dat$polholder_gender)
dat$polholder_job = as.factor(dat$polholder_job)
dat$prem_freqperyear = as.factor(dat$prem_freqperyear)
dat$vehicl_garage = as.factor(dat$vehicl_garage)
dat$vehicl_region = as.factor(dat$vehicl_region)
dat$polholder_diffdriver = as.factor(dat$polholder_diffdriver)
dat$policy_caruse = as.factor(dat$policy_caruse)
dat$vehicl_powerkw = gsub(" kW", "", dat$vehicl_powerkw)
# Split data into test and train subsets
train_index = sample(1:nrow(dat), 0.75*nrow(dat))
train_data = dat[train_index, ]
test_data = dat[-train_index, ]
# Fit the GLM
glm.fit = glm(lapse~., data=train_data, family="binomial")
# look at statistically significant variables
# looks at the P(|z|) values
# returns a list of statistically significant variables.
which(summary(glm.fit)$coef[,4] < 0.05)
glm.probs = predict(glm.fit, newdata=test_data, type="response")
dat = eudirectlapse
eudirectlapse <- read.csv("C:/Users/ronan/Downloads/eudirectlapse.csv")
View(eudirectlapse)
dat = eudirectlapse
dat = na.omit(dat)
dat$polholder_BMCevol = as.factor(dat$polholder_BMCevol)
dat$polholder_gender = as.factor(dat$polholder_gender)
dat$polholder_job = as.factor(dat$polholder_job)
dat$prem_freqperyear = as.factor(dat$prem_freqperyear)
dat$vehicl_garage = as.factor(dat$vehicl_garage)
dat$vehicl_region = as.factor(dat$vehicl_region)
dat$polholder_diffdriver = as.factor(dat$polholder_diffdriver)
dat$policy_caruse = as.factor(dat$policy_caruse)
dat$vehicl_powerkw = gsub(" kW", "", dat$vehicl_powerkw)
# Split data into test and train subsets
train_index = sample(1:nrow(dat), 0.75*nrow(dat))
train_data = dat[train_index, ]
test_data = dat[-train_index, ]
# Fit the GLM
glm.fit = glm(lapse~., data=train_data, family="binomial")
# look at statistically significant variables
# looks at the P(|z|) values
# returns a list of statistically significant variables.
which(summary(glm.fit)$coef[,4] < 0.05)
glm.probs = predict(glm.fit, newdata=test_data, type="response")
glm.probs[1:10]
glm.pred = rep(0, nrow(dat))
glm.pred[glm.probs >.5] = 1
table(glm.pred,dat$lapse)
mean(glm.pred==dat$lapse)
# predicts correctly 87.2% of the time
summary(glm.fit)
