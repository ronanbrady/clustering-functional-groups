set.seed(123)
d = trees
B = 100 # number of bootstrap samples we want to estimate
n = nrow(d) # number of sample observations
boot_sample_slopes = 1:B # setup for the response variable
for(b in 1:B){
n_sampled = sample(1:n, n, replace=TRUE) # sample with replacement
boot_sample = d[n_sampled,] # get the observations of the sample
model = lm(Height ~ Girth, data = boot_sample) # fit a linear model of Height against Girth
boot_sample_slopes[b] = model$coefficients[2] # get and store the slope coefficient for each model
}
boxplot(boot_sample_slopes, ylab = "Regression slope parameter (Height v Girth)")
