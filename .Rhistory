library(MASS)
data("Insurance")
head(Insurance)
gamma_model <- glm(
Claims ~ District + Group + Age + Holders,
data = Insurance,
family = Gamma(link = "log")
)
summary(gamma_model)
Insurance$CLaims
Insurance$Claims
which(Insurance$Claims == 0)
Insurance$Claims[which(Insurance$Claims == 0)]
Insurance$Claims[which(Insurance$Claims == 0)] + 0.0001
Insurance$Claims[which(Insurance$Claims == 0)] + 1e-4
Insurance$Claims[which(Insurance$Claims == 0)] = Insurance$Claims[which(Insurance$Claims == 0)] + 1e-4
Insurance$Claims
# add a negligible small constant to claim entries of 0 to allow fitting to gamma GLM
Insurance$Claims[which(Insurance$Claims == 0)] = Insurance$Claims[which(Insurance$Claims == 0)] + 1e-4
gamma_model <- glm(
Claims ~ District + Group + Age + Holders,
data = Insurance,
family = Gamma(link = "log")
)
summary(gamma_model)
anova(gamma_model, test="Chisq")
library(boot)
cv.glm(Insurance, gamma_model, K=10)$delta
